    "staticWebsiteUrl": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'storage-deployment'), '2025-04-01').outputs.staticWebsiteUrl.value]"
    },
    "cdnEndpointUrl": {
      "type": "string",
      "value": "[if(and(parameters('enableCdn'), not(equals(reference(resourceId('Microsoft.Resources/deployments', 'cdn-deployment'), '2025-04-01'), null()))), reference(resourceId('Microsoft.Resources/deployments', 'cdn-deployment'), '2025-04-01').outputs.cdnEndpointUrl.value, '')]"
    },
    "primaryEndpoint": {
      "type": "string",
      "value": "[if(and(parameters('enableCdn'), not(equals(reference(resourceId('Microsoft.Resources/deployments', 'cdn-deployment'), '2025-04-01'), null()))), reference(resourceId('Microsoft.Resources/deployments', 'cdn-deployment'), '2025-04-01').outputs.cdnEndpointUrl.value, reference(resourceId('Microsoft.Resources/deployments', 'storage-deployment'), '2025-04-01').outputs.staticWebsiteUrl.value)]"
    }
  }
