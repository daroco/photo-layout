          "cdnEndpointName": {
            "value": "[format('photolayout-{0}', parameters('environment'))]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "originHostName": {
            "value": "[reference(resourceId('Microsoft.Resources/deployments', 'storage-deployment'), '2025-04-01').outputs.staticWebsiteHostName.value]"
          },
          "tags": {
            "value": "[parameters('tags')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.39.26.7824",
              "templateHash": "6862038246136300323"
            }
          },
          "parameters": {
            "cdnProfileName": {
              "type": "string",
              "metadata": {
                "description": "CDN Profile name"
              }
            },
            "cdnEndpointName": {
              "type": "string",
              "metadata": {
                "description": "CDN Endpoint name"
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "Location for CDN resources"
              }
            },
            "originHostName": {
              "type": "string",
              "metadata": {
                "description": "Origin hostname (storage static website)"
              }
            },
            "tags": {
              "type": "object",
              "metadata": {
                "description": "Resource tags"
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Cdn/profiles",
              "apiVersion": "2023-05-01",
              "name": "[parameters('cdnProfileName')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "sku": {
                "name": "Standard_Microsoft"
              },
              "properties": {}
            },
            {
              "type": "Microsoft.Cdn/profiles/endpoints",
              "apiVersion": "2023-05-01",
              "name": "[format('{0}/{1}', parameters('cdnProfileName'), parameters('cdnEndpointName'))]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "properties": {
                "originHostHeader": "[parameters('originHostName')]",
                "isHttpAllowed": false,
                "isHttpsAllowed": true,
                "queryStringCachingBehavior": "IgnoreQueryString",
                "contentTypesToCompress": [
                  "text/plain",
                  "text/html",
                  "text/css",
                  "application/javascript",
                  "application/json",
                  "image/svg+xml"
                ],
                "isCompressionEnabled": true,
                "origins": [
                  {
                    "name": "origin1",
                    "properties": {
                      "hostName": "[parameters('originHostName')]",
                      "httpPort": 80,
                      "httpsPort": 443,
                      "originHostHeader": "[parameters('originHostName')]"
                    }
                  }
                ],
                "deliveryPolicy": {
                  "rules": [
                    {
                      "name": "Global",
                      "order": 0,
                      "actions": [
                        {
                          "name": "CacheExpiration",
                          "parameters": {
                            "cacheBehavior": "SetIfMissing",
                            "cacheType": "All",
                            "cacheDuration": "7.00:00:00",
                            "typeName": "DeliveryRuleCacheExpirationActionParameters"
                          }
                        }
                      ]
                    }
                  ]
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.Cdn/profiles', parameters('cdnProfileName'))]"
              ]
            }
          ],
          "outputs": {
            "cdnProfileName": {
              "type": "string",
              "value": "[parameters('cdnProfileName')]"
            },
            "cdnEndpointName": {
              "type": "string",
              "value": "[parameters('cdnEndpointName')]"
            },
            "cdnEndpointUrl": {
              "type": "string",
              "value": "[format('https://{0}', reference(resourceId('Microsoft.Cdn/profiles/endpoints', parameters('cdnProfileName'), parameters('cdnEndpointName')), '2023-05-01').hostName)]"
            }
          }
        }
      },
      "dependsOn": [
