            "storageAccountId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
            },
            "staticWebsiteUrl": {
              "type": "string",
              "value": "[format('https://{0}.z13.web.{1}/', parameters('storageAccountName'), environment().suffixes.storage)]"
            },
            "staticWebsiteHostName": {
              "type": "string",
              "value": "[format('{0}.z13.web.{1}', parameters('storageAccountName'), environment().suffixes.storage)]"
